[
  {
    "title": "Clock",
    "html": "<style>h1{font-size:2rem;margin:0 0 12px}button{background:#214c41;color:#a9f6d9;border:1px solid #37755f;border-radius:12px;padding:12px;margin:5px}input,textarea{background:#192637;color:#eff6ff;border:1px solid #3a4b62;border-radius:10px;padding:10px;box-sizing:border-box}small{color:#a6b7cd}</style><h1 id=\"time\"></h1><p id=\"date\"></p><small>Your headset’s local time</small><script>const time=document.getElementById(\"time\"),date=document.getElementById(\"date\");function draw(){const d=new Date();time.textContent=d.toLocaleTimeString();date.textContent=d.toLocaleDateString(undefined,{weekday:\"long\",month:\"long\",day:\"numeric\"})}draw();setInterval(draw,1000)</script>"
  },
  {
    "title": "Notes",
    "html": "<style>h1{font-size:2rem;margin:0 0 12px}button{background:#214c41;color:#a9f6d9;border:1px solid #37755f;border-radius:12px;padding:12px;margin:5px}input,textarea{background:#192637;color:#eff6ff;border:1px solid #3a4b62;border-radius:10px;padding:10px;box-sizing:border-box}small{color:#a6b7cd}</style><h1>Notes</h1><textarea id=\"note\" aria-label=\"Notes\" style=\"width:100%;height:60vh\"></textarea><p id=\"status\">Saved locally on this headset</p><script>const note=document.getElementById(\"note\"),status=document.getElementById(\"status\");note.value=luma.loadState().text||\"\";note.oninput=()=>{luma.saveState({text:note.value});status.textContent=\"Saved locally\"}</script>"
  },
  {
    "title": "Checklist",
    "html": "<style>h1{font-size:2rem;margin:0 0 12px}button{background:#214c41;color:#a9f6d9;border:1px solid #37755f;border-radius:12px;padding:12px;margin:5px}input,textarea{background:#192637;color:#eff6ff;border:1px solid #3a4b62;border-radius:10px;padding:10px;box-sizing:border-box}small{color:#a6b7cd}</style><h1>Checklist</h1><form id=\"form\"><input id=\"task\" aria-label=\"New task\" placeholder=\"New task\"><button>Add</button></form><section id=\"list\"></section><script>const form=document.getElementById(\"form\"),task=document.getElementById(\"task\"),list=document.getElementById(\"list\");let items=luma.loadState().items||[];function draw(){list.replaceChildren();items.forEach((item,i)=>{const row=document.createElement(\"p\"),check=document.createElement(\"input\"),label=document.createElement(\"span\"),remove=document.createElement(\"button\");check.type=\"checkbox\";check.checked=item.done;label.textContent=\" \"+item.text;remove.textContent=\"Remove\";check.onchange=()=>{items[i].done=check.checked;save()};remove.onclick=()=>{items.splice(i,1);save();draw()};row.append(check,label,remove);list.append(row)})}function save(){luma.saveState({items})}form.onsubmit=e=>{e.preventDefault();if(task.value.trim()){items.push({text:task.value.trim(),done:false});task.value=\"\";save();draw()}};draw()</script>"
  },
  {
    "title": "Focus timer",
    "html": "<style>h1{font-size:2rem;margin:0 0 12px}button{background:#214c41;color:#a9f6d9;border:1px solid #37755f;border-radius:12px;padding:12px;margin:5px}input,textarea{background:#192637;color:#eff6ff;border:1px solid #3a4b62;border-radius:10px;padding:10px;box-sizing:border-box}small{color:#a6b7cd}</style><h1>Focus timer</h1><p id=\"readout\" style=\"font-size:3rem\"></p><label>Minutes <input id=\"minutes\" type=\"number\" min=\"1\" max=\"180\" value=\"25\" style=\"width:100px\"></label><button id=\"start\">Start</button><button id=\"stop\">Reset</button><small>Timer continues by wall-clock time when hidden.</small><script>const readout=document.getElementById(\"readout\"),minutes=document.getElementById(\"minutes\"),start=document.getElementById(\"start\"),stop=document.getElementById(\"stop\");let end=luma.loadState().end||0;function draw(){let seconds=end?Math.max(0,Math.ceil((end-Date.now())/1000)):Number(minutes.value)*60;readout.textContent=end&&seconds===0?\"Time’s up\":Math.floor(seconds/60)+\":\"+String(seconds%60).padStart(2,\"0\")}start.onclick=()=>{end=Date.now()+Math.max(1,Math.min(180,Number(minutes.value)||25))*60000;luma.saveState({end});draw()};stop.onclick=()=>{end=0;luma.saveState({end});draw()};draw();setInterval(draw,500)</script>"
  },
  {
    "title": "Calculator",
    "html": "<style>h1{font-size:2rem;margin:0 0 12px}button{background:#214c41;color:#a9f6d9;border:1px solid #37755f;border-radius:12px;padding:12px;margin:5px}input,textarea{background:#192637;color:#eff6ff;border:1px solid #3a4b62;border-radius:10px;padding:10px;box-sizing:border-box}small{color:#a6b7cd}</style><h1>Calculator</h1><input id=\"a\" aria-label=\"First number\" type=\"number\" value=\"0\"><select id=\"operation\" aria-label=\"Operation\"><option>+</option><option>−</option><option>×</option><option>÷</option></select><input id=\"b\" aria-label=\"Second number\" type=\"number\" value=\"0\"><h2 id=\"answer\"></h2><script>const a=document.getElementById(\"a\"),b=document.getElementById(\"b\"),operation=document.getElementById(\"operation\"),answer=document.getElementById(\"answer\");function calculate(){const x=Number(a.value),y=Number(b.value),op=operation.value;answer.textContent=op===\"+\"?x+y:op===\"−\"?x-y:op===\"×\"?x*y:y===0?\"Cannot divide by zero\":x/y}a.oninput=b.oninput=operation.onchange=calculate;calculate()</script>"
  }
]