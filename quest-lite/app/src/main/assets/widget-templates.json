[
  {
    "title": "Clock",
    "html": "<style>h1{font-size:2rem;margin:0 0 12px}button{background:#214c41;color:#a9f6d9;border:1px solid #37755f;border-radius:12px;padding:12px;margin:5px}input,textarea{background:#192637;color:#eff6ff;border:1px solid #3a4b62;border-radius:10px;padding:10px;box-sizing:border-box}small{color:#a6b7cd}</style><h1 id=\"time\"></h1><p id=\"date\"></p><small>Your headset’s local time</small><script>const time=document.getElementById(\"time\"),date=document.getElementById(\"date\");function draw(){const d=new Date();time.textContent=d.toLocaleTimeString();date.textContent=d.toLocaleDateString(undefined,{weekday:\"long\",month:\"long\",day:\"numeric\"})}draw();setInterval(draw,1000)</script>"
  },
  {
    "title": "Notes",
    "html": "<style>h1{font-size:2rem;margin:0 0 12px}button{background:#214c41;color:#a9f6d9;border:1px solid #37755f;border-radius:12px;padding:12px;margin:5px}input,textarea{background:#192637;color:#eff6ff;border:1px solid #3a4b62;border-radius:10px;padding:10px;box-sizing:border-box}small{color:#a6b7cd}</style><h1>Notes</h1><textarea id=\"note\" aria-label=\"Notes\" style=\"width:100%;height:60vh\"></textarea><p id=\"status\">Saved locally on this headset</p><script>const note=document.getElementById(\"note\"),status=document.getElementById(\"status\");note.value=luma.loadState().text||\"\";note.oninput=()=>{luma.saveState({text:note.value});status.textContent=\"Saved locally\"}</script>"
  },
  {
    "title": "Checklist",
    "html": "<style>h1{font-size:2rem;margin:0 0 12px}button{background:#214c41;color:#a9f6d9;border:1px solid #37755f;border-radius:12px;padding:12px;margin:5px}input,textarea{background:#192637;color:#eff6ff;border:1px solid #3a4b62;border-radius:10px;padding:10px;box-sizing:border-box}small{color:#a6b7cd}</style><h1>Checklist</h1><form id=\"form\"><input id=\"task\" aria-label=\"New task\" placeholder=\"New task\"><button>Add</button></form><section id=\"list\"></section><script>const form=document.getElementById(\"form\"),task=document.getElementById(\"task\"),list=document.getElementById(\"list\");let items=luma.loadState().items||[];function draw(){list.replaceChildren();items.forEach((item,i)=>{const row=document.createElement(\"p\"),check=document.createElement(\"input\"),label=document.createElement(\"span\"),remove=document.createElement(\"button\");check.type=\"checkbox\";check.checked=item.done;label.textContent=\" \"+item.text;remove.textContent=\"Remove\";check.onchange=()=>{items[i].done=check.checked;save()};remove.onclick=()=>{items.splice(i,1);save();draw()};row.append(check,label,remove);list.append(row)})}function save(){luma.saveState({items})}form.onsubmit=e=>{e.preventDefault();if(task.value.trim()){items.push({text:task.value.trim(),done:false});task.value=\"\";save();draw()}};draw()</script>"
  },
  {
    "title": "Focus timer",
    "html": "<style>h1{font-size:2rem;margin:0 0 12px}button{background:#214c41;color:#a9f6d9;border:1px solid #37755f;border-radius:12px;padding:12px;margin:5px}input,textarea{background:#192637;color:#eff6ff;border:1px solid #3a4b62;border-radius:10px;padding:10px;box-sizing:border-box}small{color:#a6b7cd}</style><h1>Focus timer</h1><p id=\"readout\" style=\"font-size:3rem\"></p><label>Minutes <input id=\"minutes\" type=\"number\" min=\"1\" max=\"180\" value=\"25\" style=\"width:100px\"></label><button id=\"start\">Start</button><button id=\"stop\">Reset</button><small>Timer continues by wall-clock time when hidden.</small><script>const readout=document.getElementById(\"readout\"),minutes=document.getElementById(\"minutes\"),start=document.getElementById(\"start\"),stop=document.getElementById(\"stop\");let end=luma.loadState().end||0;function draw(){let seconds=end?Math.max(0,Math.ceil((end-Date.now())/1000)):Number(minutes.value)*60;readout.textContent=end&&seconds===0?\"Time’s up\":Math.floor(seconds/60)+\":\"+String(seconds%60).padStart(2,\"0\")}start.onclick=()=>{end=Date.now()+Math.max(1,Math.min(180,Number(minutes.value)||25))*60000;luma.saveState({end});draw()};stop.onclick=()=>{end=0;luma.saveState({end});draw()};draw();setInterval(draw,500)</script>"
  },
  {
    "title": "Calculator",
    "html": "<style>h1{font-size:2rem;margin:0 0 12px}button{background:#214c41;color:#a9f6d9;border:1px solid #37755f;border-radius:12px;padding:12px;margin:5px}input,textarea{background:#192637;color:#eff6ff;border:1px solid #3a4b62;border-radius:10px;padding:10px;box-sizing:border-box}small{color:#a6b7cd}</style><h1>Calculator</h1><input id=\"a\" aria-label=\"First number\" type=\"number\" value=\"0\"><select id=\"operation\" aria-label=\"Operation\"><option>+</option><option>−</option><option>×</option><option>÷</option></select><input id=\"b\" aria-label=\"Second number\" type=\"number\" value=\"0\"><h2 id=\"answer\"></h2><script>const a=document.getElementById(\"a\"),b=document.getElementById(\"b\"),operation=document.getElementById(\"operation\"),answer=document.getElementById(\"answer\");function calculate(){const x=Number(a.value),y=Number(b.value),op=operation.value;answer.textContent=op===\"+\"?x+y:op===\"−\"?x-y:op===\"×\"?x*y:y===0?\"Cannot divide by zero\":x/y}a.oninput=b.oninput=operation.onchange=calculate;calculate()</script>"
  },
  {
    "title": "Mind Inbox",
    "html": "<style>\n  body { max-width: 34rem; margin: 0 auto; padding: clamp(14px, 4vw, 26px); line-height: 1.45; }\n  h1 { font-size: 1.85rem; line-height: 1.15; margin: 0 0 .4rem; }\n  h2 { font-size: 1.1rem; margin: 1.25rem 0 .45rem; }\n  p { margin: 0 0 .75rem; color: #b7c7d9; }\n  label { font-weight: 600; }\n  form { display: flex; flex-wrap: wrap; gap: .55rem; margin-top: .4rem; }\n  input[type=text], button { min-height: 46px; box-sizing: border-box; border: 1px solid #526782; border-radius: 10px; padding: .55rem .75rem; }\n  input[type=text] { color: #f2f7ff; background: #192637; width: 100%; }\n  form input { flex: 1 1 12rem; }\n  button { background: #263950; color: #f2f7ff; }\n  form button { background: #b5efd9; color: #12372d; border-color: #b5efd9; font-weight: 700; }\n  :focus-visible { outline: 3px solid #a6e4ff; outline-offset: 2px; }\n  ul { padding: 0; margin: 0; list-style: none; display: grid; gap: .5rem; }\n  li { display: flex; flex-wrap: wrap; gap: .4rem; align-items: center; padding: .55rem; background: #192637; border-radius: 10px; }\n  li span { flex: 1 1 9rem; min-width: 0; overflow-wrap: anywhere; }\n  li button[aria-pressed=true] { color: #b5efd9; border-color: #8bcab5; background: #214c41; }\n  li label { display: flex; min-height: 46px; align-items: center; gap: .5rem; flex: 1 1 10rem; font-weight: 400; }\n  li input { width: 1.3rem; height: 1.3rem; accent-color: #b5efd9; flex: none; }\n  li input:checked + span { text-decoration: line-through; color: #b7c7d9; }\n  #status { min-height: 1.45em; font-size: .9rem; margin: .65rem 0; }\n</style>\n<h1>Mind Inbox</h1>\n<p>Put a thought here and come back to it when you have energy.</p>\n<label for=\"capture\">Quick capture</label>\n<form id=\"capture-form\">\n  <input id=\"capture\" type=\"text\" maxlength=\"180\" placeholder=\"What’s on your mind?\">\n  <button>Capture</button>\n</form>\n<p id=\"status\" role=\"status\"></p>\n<h2>Captured thoughts</h2>\n<p id=\"empty\">Your inbox is empty.</p>\n<ul id=\"thoughts\"></ul>\n<script>\n  const saved = luma.loadState() || {};\n  let state = saved.mindInbox || [];\n  const status = document.getElementById('status');\n\n  function save(next, message) {\n    try {\n      luma.saveState({ ...saved, mindInbox: next });\n      state = next;\n      status.textContent = message;\n      return true;\n    } catch (error) {\n      status.textContent = 'Could not save. Free up space or try again.';\n      return false;\n    }\n  }\n\n  const capture = document.getElementById('capture');\n  const list = document.getElementById('thoughts');\n  const empty = document.getElementById('empty');\n\n  function draw() {\n    empty.hidden = state.length > 0;\n    list.replaceChildren(...state.map((item, index) => {\n      const row = document.createElement('li');\n      const text = document.createElement('span');\n      const toggle = document.createElement('button');\n      const remove = document.createElement('button');\n      text.textContent = item.text;\n      toggle.textContent = 'Next action';\n      toggle.setAttribute('aria-label', 'Next action for ' + item.text);\n      toggle.setAttribute('aria-pressed', String(item.next));\n      toggle.onclick = () => {\n        const next = !state[index].next;\n        const updated = state.map((entry, i) => i === index ? { ...entry, next } : entry);\n        if (save(updated, next ? 'Marked as a next action.' : 'Next action cleared.')) {\n          toggle.setAttribute('aria-pressed', String(next));\n        }\n      };\n      remove.textContent = 'Remove';\n      remove.setAttribute('aria-label', 'Remove ' + item.text);\n      remove.onclick = () => {\n        if (save(state.filter((entry, i) => i !== index), 'Thought removed.')) {\n          draw();\n          (list.children[index]?.querySelector('button') || capture).focus();\n        }\n      };\n      row.append(text, toggle, remove);\n      return row;\n    }));\n  }\n\n  document.getElementById('capture-form').onsubmit = event => {\n    event.preventDefault();\n    const text = capture.value.trim();\n    if (!text) {\n      capture.focus();\n      return;\n    }\n    if (state.length >= 24) {\n      status.textContent = 'Inbox is full. Remove a thought to make room.';\n      return;\n    }\n    if (save([{ text, next: false }, ...state], 'Thought captured.')) {\n      capture.value = '';\n      draw();\n    }\n    capture.focus();\n  };\n  draw();\n</script>"
  },
  {
    "title": "Today",
    "html": "<style>\n  body { max-width: 34rem; margin: 0 auto; padding: clamp(14px, 4vw, 26px); line-height: 1.45; }\n  h1 { font-size: 1.85rem; line-height: 1.15; margin: 0 0 .4rem; }\n  h2 { font-size: 1.1rem; margin: 1.25rem 0 .45rem; }\n  p { margin: 0 0 .75rem; color: #b7c7d9; }\n  label { font-weight: 600; }\n  form { display: flex; flex-wrap: wrap; gap: .55rem; margin-top: .4rem; }\n  input[type=text], button { min-height: 46px; box-sizing: border-box; border: 1px solid #526782; border-radius: 10px; padding: .55rem .75rem; }\n  input[type=text] { color: #f2f7ff; background: #192637; width: 100%; }\n  form input { flex: 1 1 12rem; }\n  button { background: #263950; color: #f2f7ff; }\n  form button { background: #b5efd9; color: #12372d; border-color: #b5efd9; font-weight: 700; }\n  :focus-visible { outline: 3px solid #a6e4ff; outline-offset: 2px; }\n  ul { padding: 0; margin: 0; list-style: none; display: grid; gap: .5rem; }\n  li { display: flex; flex-wrap: wrap; gap: .4rem; align-items: center; padding: .55rem; background: #192637; border-radius: 10px; }\n  li span { flex: 1 1 9rem; min-width: 0; overflow-wrap: anywhere; }\n  li button[aria-pressed=true] { color: #b5efd9; border-color: #8bcab5; background: #214c41; }\n  li label { display: flex; min-height: 46px; align-items: center; gap: .5rem; flex: 1 1 10rem; font-weight: 400; }\n  li input { width: 1.3rem; height: 1.3rem; accent-color: #b5efd9; flex: none; }\n  li input:checked + span { text-decoration: line-through; color: #b7c7d9; }\n  #status { min-height: 1.45em; font-size: .9rem; margin: .65rem 0; }\n</style>\n<h1>Today</h1>\n<p>Choose one priority. Make the first step small.</p>\n<label for=\"priority\">One priority</label>\n<input id=\"priority\" type=\"text\" maxlength=\"180\" placeholder=\"What matters most today?\">\n<h2>Tiny steps</h2>\n<label for=\"step\">New step</label>\n<form id=\"step-form\">\n  <input id=\"step\" type=\"text\" maxlength=\"100\" placeholder=\"e.g. Open the document\">\n  <button>Add step</button>\n</form>\n<p id=\"status\" role=\"status\"></p>\n<p id=\"empty\">Add a step whenever you’re ready.</p>\n<ul id=\"steps\"></ul>\n<script>\n  const saved = luma.loadState() || {};\n  let state = saved.today || { priority: '', steps: [] };\n  const status = document.getElementById('status');\n\n  function save(next, message) {\n    try {\n      luma.saveState({ ...saved, today: next });\n      state = next;\n      status.textContent = message;\n      return true;\n    } catch (error) {\n      status.textContent = 'Could not save. Free up space or try again.';\n      return false;\n    }\n  }\n\n  const priority = document.getElementById('priority');\n  const step = document.getElementById('step');\n  const list = document.getElementById('steps');\n  const empty = document.getElementById('empty');\n\n  priority.value = state.priority;\n  priority.oninput = () => save({ ...state, priority: priority.value }, 'Priority saved.');\n\n  function draw() {\n    empty.hidden = state.steps.length > 0;\n    list.replaceChildren(...state.steps.map((item, index) => {\n      const row = document.createElement('li');\n      const label = document.createElement('label');\n      const check = document.createElement('input');\n      const text = document.createElement('span');\n      const remove = document.createElement('button');\n      check.type = 'checkbox';\n      check.checked = item.done;\n      text.textContent = item.text;\n      check.onchange = () => {\n        const done = check.checked;\n        const steps = state.steps.map((entry, i) => i === index ? { ...entry, done } : entry);\n        if (!save({ ...state, steps }, done ? 'Step complete.' : 'Step reopened.')) check.checked = !done;\n      };\n      remove.textContent = 'Remove';\n      remove.setAttribute('aria-label', 'Remove ' + item.text);\n      remove.onclick = () => {\n        const steps = state.steps.filter((entry, i) => i !== index);\n        if (save({ ...state, steps }, 'Step removed.')) {\n          draw();\n          (list.children[index]?.querySelector('input') || step).focus();\n        }\n      };\n      label.append(check, text);\n      row.append(label, remove);\n      return row;\n    }));\n  }\n\n  document.getElementById('step-form').onsubmit = event => {\n    event.preventDefault();\n    const text = step.value.trim();\n    if (!text) {\n      step.focus();\n      return;\n    }\n    if (state.steps.length >= 12) {\n      status.textContent = 'Step list is full. Remove a step to make room.';\n      return;\n    }\n    const steps = [...state.steps, { text, done: false }];\n    if (save({ ...state, steps }, 'Step added.')) {\n      step.value = '';\n      draw();\n    }\n    step.focus();\n  };\n  draw();\n</script>"
  }
]
